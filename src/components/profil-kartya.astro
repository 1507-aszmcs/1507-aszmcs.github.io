---
const { nev } = Astro.props
const { beosztas } = Astro.props
const { email } = Astro.props
const { tel } = Astro.props
const { kep_path } = Astro.props
---

<div class="w-full flex flex-col items-center bg-[#B2BEB5] py-5 md:py-10 px-5 md:px-0 rounded-xl lg:shadow-sm lg:shadow-[#0f1955]">
    <img src={kep_path} alt="" class="w-full md:w-4/5 border-6 md:border-10 border-white">
    <div class="flex flex-col items-center">
        <h3 class="text-2xl font-semibold mb-0 pt-3 mb-1">{nev}</h3>
        <p class="uppercase text-sm">{beosztas}</p>
        <a class="my-1 underline" href={`mailto:${email}`}>{email}</a>
        <p>{tel}</p>
    </div>
</div>