---
const { nev } = Astro.props
const { beosztas } = Astro.props
const { email } = Astro.props
const { tel } = Astro.props
const { kep_path } = Astro.props
---

<div class="w-64 sm:w-72 flex flex-col items-center bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
    <img src={kep_path} alt={nev} class="w-full h-auto" loading="lazy">
    <div class="flex flex-col items-center text-center w-full px-4 py-5 gap-1">
        <h3 class="text-lg font-bold text-[#0f1955]">{nev}</h3>
        <p class="text-xs font-semibold uppercase tracking-wide text-[#0c5522]">{beosztas}</p>
        <a href={`mailto:${email}`} class="text-sm text-gray-600 hover:text-[#e1642c] transition-colors mt-2 break-all">{email}</a>
        <p class="text-sm text-gray-600">{tel}</p>
    </div>
</div>
