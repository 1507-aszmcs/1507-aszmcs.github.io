---
import "../styles/global.css";
import "../styles/scrollbar.css";
import "../styles/gombok.css";

import OldalMinta from "../layouts/sima-oldal.astro"
---

<OldalMinta oldal_cim="SZMCSWEB" oldal_link={Astro.url.href} oldal_leiras="A cserkészcsapat kis webes felülete">
    <div class="px-10 lg:px-20 flex items-center justify-center">
        <div class="flex flex-col content-center justify-center">
            <div class="flex flex-col gap-2 px-10 mx-5 lg:mx-20 text-justify">
                <h2 class="self-center text-3xl font-semibold">Tájékoztató</h2>
                <p class="">
                    Kedves Cserkésztestvérek! Ezen oldalon tudjátok elérni a csapatunk online segédeszközeit, valamint az új online <strong>parancstáblát</strong> is.
                    Ha kérdésetek van, nyugodtan keressetek meg <a href="mailto:farkas.tobias@cserkesz.hu" class="italic underline">emailben</a>.
                </p>
                <p>
                    Ha készítettél bejegyzést/blogot a weboldalra, szintén írj rám emailben, illetve messengeren is! Az emailbe mindenképpen írd bele a neved, ecset azonotsítódat
                     és az őrsöd nevét! 
                </p>
                <p>JM!<br>Farkas Tóbiás</p>

            </div>
            <hr class="w-4/5 border-2 rounded-xl border-[#0f1955] my-5 self-center">
            <div class="mt-3 pl-10 pr-10 pb-5 ml-10 mr-10 md:ml-0 md:mr-0 flex flex-col md:flex-row gap-3 justify-center items-center">
                <h2 class="self-center text-xl font-semibold">ŐV</h2>
                <a href="/fileok/poszt_creator.html" class="elsodleges px-6! py-3! text-center max-w-sm">Posztkészítő</a>
                <a href="https://docs.google.com/document/d/e/2PACX-1vQ8kNKhMdzAWDk_xa90xfyP01b-J08_71bxNH8N-utoDYq_PkeVRV9GmW24GKwdNp6hrSxYD0uSw2SP/pub" class="masodlagos max-w-sm px-6! py-3! text-center" target="_blank">Parancstábla</a>
            </div>
            <hr class="w-1/2 border-1 rounded-xl border-[#0f1955] my-1 self-center">
            <div class="mt-3 pl-10 pr-10 ml-10 mr-10 md:ml-0 md:mr-0 flex flex-col md:flex-row gap-3 justify-center items-center">
                <h2 class="self-center text-xl font-semibold">OP</h2>
                <a href="https://desktop-159g1ln.taild90296.ts.net" target="_blank" class="elsodleges text-center px-6! py-3! max-w-sm">Raktár</a>
            </div>
        </div>
    </div>
</OldalMinta>

