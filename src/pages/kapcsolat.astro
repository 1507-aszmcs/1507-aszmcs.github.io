---
import "../styles/global.css";
import "../styles/scrollbar.css";
import "../styles/gombok.css";

import OldalMinta from "../layouts/sima-oldal.astro"

import ProfilKartya from "../components/profil-kartya.astro"
---

<OldalMinta oldal_cim="Kapcsolat" oldal_link={Astro.url.href} oldal_leiras="A csapatparancsnok, a csapatparancsnok-helyettes, a korosztályok, illetve a rajok vezetőinek elérhetősége email, illetve telefonszám formájában.">
	<div class="px-6 md:px-20 flex flex-col items-center w-full my-10 lg:my-16"><!-- Az oldal alap paddingja -->
        <section class="w-full flex flex-col items-center">
            <h2 class="text-[#0f1955] text-xl md:text-2xl font-bold uppercase tracking-wide text-center">Csapatparancsnok és Helyettes</h2>
            <div class="flex flex-wrap justify-center gap-6 mt-6">
                <ProfilKartya nev="Kuna Máté" beosztas="csapatparancsnok" email="kuna.mate@cserkesz.hu" tel="+36 20 232 9709" kep_path="/profilok/Kuna.jpg" />
                <ProfilKartya nev="Várnagy Anna" beosztas="csapatparancsnok-helyettes" email="varnagy.anna@cserkesz.hu" tel="+36 70 666 1100" kep_path="/profilok/Varnagy.jpg" />
            </div>
        </section>

        <hr class="w-full max-w-md border-t border-gray-200 my-14">

        <h2 class="text-[#0f1955] text-2xl md:text-3xl font-bold text-center uppercase mb-10">Korosztályok és Rajok</h2>

        <div class="w-full flex flex-col gap-14">
            <section class="w-full flex flex-col items-center">
                <h3 class="text-[#0c5522] text-xl md:text-2xl font-bold text-center">Kiscserkész Korosztály</h3>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Szalkai Attila" beosztas="cserkész korosztályparancsnok" email="szalkai.attila@cserkesz.hu" kep_path="/profilok/Attila.jpg" />
                </div>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Vilmos Édua" beosztas="3. évf. rajparancsnok" email="vilmos.edua@gmail.com" kep_path="/profilok/Edua.jpg" />
                    <ProfilKartya nev="Laukó Emese" beosztas="4. évf. rajparancsnok" email="lauko.emese@cserkesz.hu" kep_path="/profilok/Mesi.jpg" />
                    <ProfilKartya nev="Gyuris Hanna" beosztas="5. évf. rajparancsnok, pénzügyes" email="gyuris.hanna@cserkesz.hu" kep_path="/profilok/Hanna.jpg" />
                </div>
            </section>

            <section class="w-full flex flex-col items-center">
                <h3 class="text-[#0c5522] text-xl md:text-2xl font-bold text-center">Cserkész Korosztály</h3>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Mezey Zsuzsi" beosztas="cserkész korosztályparancsnok" email="mezey.zsuzsanna@cserkesz.hu" kep_path="/profilok/Zsuzsi.jpg" />
                </div>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Dobay Kinga" beosztas="6. évf. rajparancsnok" email="dobay.kinga@cserkesz.hu" kep_path="/profilok/Kinga.jpg" />
                    <ProfilKartya nev="Jusztin Barnabás" beosztas="7. évf. rajparancsnok" email="jusztin.barnabas@cserkesz.hu" kep_path="/profilok/Barni.jpg" />
                    <ProfilKartya nev="Pinnyey Zsóka Borbála" beosztas="8. évf. rajparancsnok" email="pinnyey.zsoka@cserkesz.hu" kep_path="/profilok/Zsoka.jpg" />
                </div>
            </section>

            <section class="w-full flex flex-col items-center">
                <h3 class="text-[#0c5522] text-xl md:text-2xl font-bold text-center">Kósza Raj</h3>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Kuna Áron" beosztas="kósza rajparancsnok" email="kot@cserkesz.hu" kep_path="/profilok/Aron.jpg" />
                    <ProfilKartya nev="Aranyosi-Vitéz Zsófia" beosztas="kósza rajparancsnok" email="aranyosi.vitez.zsofia@cserkesz.hu" kep_path="/profilok/Zsofi.jpg" />
                </div>
            </section>

            <section class="w-full flex flex-col items-center">
                <h3 class="text-[#0c5522] text-xl md:text-2xl font-bold text-center">Vándor Raj</h3>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Kovács Gábor" beosztas="vándor rajparancsnok" email="kovgabi01@gmail.com" kep_path="/profilok/Gábor.png" />
                    <ProfilKartya nev="Kakas Rézi" beosztas="vándor rajparancsnok" email="kakas.regina@cserkesz.hu" kep_path="/profilok/Rezi.jpg" />
                </div>
            </section>

            <section class="w-full flex flex-col items-center">
                <h3 class="text-[#0c5522] text-xl md:text-2xl font-bold text-center">Operatív Raj</h3>
                <div class="flex flex-wrap justify-center gap-6 mt-6">
                    <ProfilKartya nev="Babos Mica" beosztas="operatív rajparancsnok" email="babos.luca@cserkesz.hu" kep_path="/profilok/Mica.jpg" />
                    <ProfilKartya nev="Gyuris Hanna" beosztas="pénzügyes" email="gyuris.hanna@cserkesz.hu" kep_path="/profilok/Hanna.jpg" />
                </div>
            </section>
        </div>
    </div>
</OldalMinta>
